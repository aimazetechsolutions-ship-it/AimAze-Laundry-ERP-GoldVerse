        <field name="name">Cash Book</field>
        <field name="tag">base_accounting_kit.interactive_account_report</field>
        <field name="context">{'report_key': 'cash_book'}</field>
    </record>

    <record id="action_interactive_day_book" model="ir.actions.client">
        <field name="name">Day Book</field>
        <field name="tag">base_accounting_kit.interactive_account_report</field>
        <field name="context">{'report_key': 'day_book'}</field>
    </record>

    <record id="account_financial_reports_profit_loss" model="ir.ui.menu">
        <field name="action" eval="'ir.actions.client,%d' % ref('base_accounting_kit.action_interactive_profit_and_loss')"/>
    </record>
    <record id="_account_financial_reports_balance_sheet" model="ir.ui.menu">
        <field name="action" eval="'ir.actions.client,%d' % ref('base_accounting_kit.action_interactive_balance_sheet')"/>
    </record>
    <record id="menu_account_cash_flow_report" model="ir.ui.menu">
        <field name="action" eval="'ir.actions.client,%d' % ref('base_accounting_kit.action_interactive_cash_flow')"/>
    </record>
    <record id="menu_Balance_report" model="ir.ui.menu">
        <field name="action" eval="'ir.actions.client,%d' % ref('base_accounting_kit.action_interactive_trial_balance')"/>
    </record>
    <record id="menu_general_ledger" model="ir.ui.menu">
        <field name="action" eval="'ir.actions.client,%d' % ref('base_accounting_kit.action_interactive_general_ledger')"/>
