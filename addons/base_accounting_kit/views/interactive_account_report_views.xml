        <field name="action" eval="'ir.actions.client,%d' % ref('base_accounting_kit.action_interactive_tax_report')"/>
    </record>
    <record id="menu_aged_trial_balance" model="ir.ui.menu">
        <field name="name">Aged Receivable</field>
        <field name="parent_id" ref="base_accounting_kit.account_reports_partner"/>
        <field name="sequence">2</field>
        <field name="action" eval="'ir.actions.client,%d' % ref('base_accounting_kit.action_interactive_aged_receivable')"/>
    </record>
    <record id="menu_aged_payable" model="ir.ui.menu">
        <field name="name">Aged Payable</field>
        <field name="parent_id" ref="base_accounting_kit.account_reports_partner"/>
        <field name="sequence">3</field>
        <field name="action" eval="'ir.actions.client,%d' % ref('base_accounting_kit.action_interactive_aged_payable')"/>
    </record>
    <record id="menu_print_journal" model="ir.ui.menu">
        <field name="action" eval="'ir.actions.client,%d' % ref('base_accounting_kit.action_interactive_journal_audit')"/>
    </record>
    <record id="account_bank_book_menu" model="ir.ui.menu">
        <field name="action" eval="'ir.actions.client,%d' % ref('base_accounting_kit.action_interactive_bank_book')"/>
