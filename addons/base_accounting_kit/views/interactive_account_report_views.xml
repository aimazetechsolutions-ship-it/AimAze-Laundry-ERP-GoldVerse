<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_interactive_profit_and_loss" model="ir.actions.client">
        <field name="name">Profit and Loss</field>
        <field name="tag">base_accounting_kit.interactive_account_report</field>
        <field name="context">{'report_key': 'profit_and_loss'}</field>
    </record>

    <record id="action_interactive_balance_sheet" model="ir.actions.client">
        <field name="name">Balance Sheet</field>
        <field name="tag">base_accounting_kit.interactive_account_report</field>
        <field name="context">{'report_key': 'balance_sheet'}</field>
