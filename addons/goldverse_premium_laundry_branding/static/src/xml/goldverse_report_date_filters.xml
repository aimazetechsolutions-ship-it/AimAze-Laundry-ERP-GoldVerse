<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.SearchBar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_cp_searchview')]" position="replace">
            <t t-if="visibilityState.showSearchBar">
                <t t-if="this.isGoldverseSearchToolbar">
                    <div class="goldverse-report-filter-shell goldverse-report-filter-shell--toolbar">
                        <div t-if="this.hasGoldverseSearchPeriodFilters" class="goldverse-report-filter-group">
                            <button type="button"
                                    t-att-class="this.goldverseSearchButtonClass('today')"
                                    t-on-click="() => this.goldverseApplySearchPeriod('today')">
                                Today
                            </button>
                            <button type="button"
                                    t-att-class="this.goldverseSearchButtonClass('mtd')"
                                    t-on-click="() => this.goldverseApplySearchPeriod('mtd')">
                                MTD
                            </button>
                            <button type="button"
                                    t-att-class="this.goldverseSearchButtonClass('ytd')"
                                    t-on-click="() => this.goldverseApplySearchPeriod('ytd')">
                                YTD
                            </button>
                            <button type="button"
                                    t-att-class="this.goldverseSearchButtonClass('itd')"
                                    t-on-click="() => this.goldverseApplySearchPeriod('itd')">
                                ITD
                            </button>
                            <button type="button"
                                    t-att-class="this.goldverseSearchButtonClass('custom')"
                                    t-on-click="() => this.goldverseApplySearchPeriod('custom')">
                                Custom
                            </button>
                        </div>

                        <div t-if="this.hasGoldverseSearchCustomerFilters" class="goldverse-report-filter-group">
                            <button type="button"
                                    t-att-class="this.goldverseSearchCustomerButtonClass('all')"
                                    t-on-click="() => this.goldverseApplySearchCustomerType('all')">
                                All Customers
                            </button>
                            <button type="button"
                                    t-att-class="this.goldverseSearchCustomerButtonClass('b2c')"
                                    t-on-click="() => this.goldverseApplySearchCustomerType('b2c')">
                                B2C
                            </button>
                            <button type="button"
                                    t-att-class="this.goldverseSearchCustomerButtonClass('b2b')"
                                    t-on-click="() => this.goldverseApplySearchCustomerType('b2b')">
                                B2B
                            </button>
                        </div>

                        <div t-if="this.goldverseSearchActivePeriod === 'custom'"
                             class="goldverse-report-custom-range is-active">
                            <input type="date" t-model="goldverseSearchToolbarState.customFrom"/>
                            <span class="goldverse-report-custom-separator">to</span>
                            <input type="date" t-model="goldverseSearchToolbarState.customTo"/>
                            <button type="button" class="btn btn-secondary" t-on-click="goldverseApplySearchCustomRange">
                                Apply
                            </button>
                        </div>

                        <div class="goldverse-report-toolbar-actions">
                            <button type="button" class="btn btn-primary" t-on-click="goldverseRefreshSearchToolbar">
                                <i class="fa fa-refresh me-1"/>Refresh
                            </button>
                        </div>
                    </div>
                </t>
            </t>
        </xpath>
    </t>
</templates>
