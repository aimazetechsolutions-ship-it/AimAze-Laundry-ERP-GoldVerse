<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_laundry_service_list_goldverse_subcategory" model="ir.ui.view">
        <field name="name">aimaze.laundry.service.list.goldverse.subcategory</field>
        <field name="model">aimaze.laundry.service</field>
        <field name="inherit_id" ref="aimaze_laundry_management.view_laundry_service_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="editable">bottom</attribute>
                <attribute name="multi_edit">1</attribute>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="goldverse_subcategory_id" string="Sub Category" optional="show"/>
                <field name="income_account_id" string="Income Head" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='list_price']" position="before">
                <field name="goldverse_base_price" string="Base Price" optional="show"/>
                <field name="goldverse_discount_amount" string="Disc (Rs.)" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="string">Net Price</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_laundry_service_form_goldverse_subcategory" model="ir.ui.view">
        <field name="name">aimaze.laundry.service.form.goldverse.subcategory</field>
        <field name="model">aimaze.laundry.service</field>
        <field name="inherit_id" ref="aimaze_laundry_management.view_laundry_service_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="goldverse_subcategory_id" string="Sub Category"/>
            </xpath>
            <xpath expr="//field[@name='list_price']" position="before">
                <field name="goldverse_base_price" string="Base Price"/>
                <field name="goldverse_discount_amount" string="Disc (Rs.)"/>
            </xpath>
            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="string">Net Price</attribute>
            </xpath>
        </field>
    </record>

    <record id="aimaze_laundry_management.action_laundry_service" model="ir.actions.act_window">
        <field name="name">Service Items</field>
    </record>

    <record id="view_laundry_service_search_goldverse" model="ir.ui.view">
        <field name="name">aimaze.laundry.service.search.goldverse</field>
        <field name="model">aimaze.laundry.service</field>
        <field name="arch" type="xml">
            <search string="Service Items">
                <field name="goldverse_search_text" string="Search All Columns" filter_domain="[('goldverse_search_text', 'ilike', self)]"/>
                <field name="code" string="Code" filter_domain="[('code', 'ilike', self)]"/>
                <field name="name" string="Name" filter_domain="[('name', 'ilike', self)]"/>
                <field name="category_id" string="Category"/>
                <field name="goldverse_subcategory_id" string="Sub Category"/>
                <field name="income_account_id" string="Income Head"/>
                <field name="pricing_method" string="Pricing Method"/>
                <field name="goldverse_base_price" string="Base Price"/>
                <field name="goldverse_discount_amount" string="Disc (Rs.)"/>
                <field name="list_price" string="Net Price"/>
                <filter name="tax_applicable" string="Tax Applicable" domain="[('tax_applicable', '=', True)]"/>
                <filter name="tax_not_applicable" string="Tax Not Applicable" domain="[('tax_applicable', '=', False)]"/>
                <filter name="active_services" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive_services" string="Inactive" domain="[('active', '=', False)]" context="{'active_test': False}"/>
                <separator/>
                <filter name="group_category" string="Group by Category" context="{'group_by': 'category_id'}"/>
                <filter name="group_subcategory" string="Group by Sub Category" context="{'group_by': 'goldverse_subcategory_id'}"/>
                <filter name="group_pricing_method" string="Group by Pricing Method" context="{'group_by': 'pricing_method'}"/>
            </search>
        </field>
    </record>

    <record id="aimaze_laundry_management.action_laundry_service" model="ir.actions.act_window">
        <field name="search_view_id" ref="view_laundry_service_search_goldverse"/>
    </record>

    <record id="view_goldverse_master_price_list" model="ir.ui.view">
        <field name="name">aimaze.laundry.service.goldverse.master.price.list</field>
        <field name="model">aimaze.laundry.service</field>
        <field name="arch" type="xml">
            <list string="GPL Master Price List" editable="bottom" multi_edit="1">
                <field name="code" string="Code" optional="show"/>
                <field name="name" string="Service Item" optional="show"/>
                <field name="category_id" string="Category" optional="show"/>
                <field name="goldverse_subcategory_id" string="Sub Category" optional="show"/>
                <field name="goldverse_base_price" string="Base Price" optional="show"/>
                <field name="goldverse_discount_amount" string="Disc (Rs.)" optional="show"/>
                <field name="goldverse_net_price" string="Net Price" optional="show"/>
                <field name="list_price" string="Order Price" optional="hide" readonly="1"/>
                <field name="income_account_id" string="Income Head" optional="show"/>
                <field name="tax_applicable" string="Tax Applicable" optional="show"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_goldverse_master_price_form" model="ir.ui.view">
        <field name="name">aimaze.laundry.service.goldverse.master.price.form</field>
        <field name="model">aimaze.laundry.service</field>
        <field name="arch" type="xml">
            <form string="GPL Master Price">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name" string="Service Item"/>
                            <field name="category_id" string="Category"/>
                            <field name="goldverse_subcategory_id" string="Sub Category"/>
                            <field name="pricing_method"/>
                        </group>
                        <group>
                            <field name="goldverse_base_price" string="Base Price"/>
                            <field name="goldverse_discount_amount" string="Disc (Rs.)"/>
                            <field name="goldverse_net_price" string="Net Price"/>
                            <field name="list_price" string="Order Price" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="income_account_id" string="Income Head"/>
                            <field name="tax_applicable"/>
                            <field name="tax_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_goldverse_master_price_list" model="ir.actions.act_window">
        <field name="name">GPL Master Price List</field>
        <field name="res_model">aimaze.laundry.service</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_goldverse_master_price_list"/>
        <field name="search_view_id" ref="view_laundry_service_search_goldverse"/>
        <field name="domain">[('active', '=', True)]</field>
        <field name="context">{'active_test': True}</field>
    </record>

    <record id="view_laundry_account_config_list_goldverse_delivery_income" model="ir.ui.view">
        <field name="name">aimaze.laundry.account.config.list.goldverse.delivery.income</field>
        <field name="model">aimaze.laundry.account.config</field>
