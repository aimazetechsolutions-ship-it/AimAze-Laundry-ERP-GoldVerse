<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_layout_goldverse_branding" inherit_id="web.login_layout" name="GoldVerse Premium Laundry Login Branding" priority="80">
        <xpath expr="//t[@t-call='web.frontend_layout']/t[@t-set='body_classname']" position="after">
            <t t-set="title" t-value="'GoldVerse Premium Laundry Powered by Odoo'"/>
        </xpath>

        <xpath expr="//div[hasclass('container')]" position="attributes">
            <attribute name="style">min-height: 100vh; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #fffaf0 0%, #f7efe0 42%, #f5f7fb 100%);</attribute>
        </xpath>

        <xpath expr="//div[contains(@t-attf-class, 'o_database_list')]" position="attributes">
            <attribute name="style">max-width: 440px; border-radius: 8px; box-shadow: 0 22px 58px rgba(43, 31, 12, 0.16); background: #ffffff !important; border: 1px solid rgba(180, 128, 42, 0.18);</attribute>
        </xpath>

        <xpath expr="//div[hasclass('text-center') and hasclass('pb-3') and hasclass('border-bottom')]" position="replace">
            <div class="text-center pb-3 border-bottom mb-4">
                <img src="/goldverse_premium_laundry_branding/static/src/img/goldverse-logo.jpeg"
                    alt="GoldVerse Premium Laundry"
                    style="max-height: 118px; max-width: 280px; width: auto; object-fit: contain; border-radius: 8px;"/>
                <h1 class="mt-3 mb-1" style="font-size: 21px; line-height: 1.25; font-weight: 700; color: #9b6a1f;">GoldVerse Premium Laundry</h1>
            </div>
        </xpath>

        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <span style="font-size: 13px; font-weight: 600;">
                <a href="https://www.aimazetechsolutions.com" target="_blank" style="color: #2bbbd3; text-decoration: none;">AimAze</a>
                <span style="color: #4b5563;"> Laundry ERP Powered by </span>
                <span style="font-weight: 700; color: #714B67;">Odoo</span>
            </span>
        </xpath>
    </template>

</odoo>
