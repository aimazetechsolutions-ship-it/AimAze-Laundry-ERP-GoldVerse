<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_laundry_order_receipt_goldverse_compact" inherit_id="aimaze_laundry_management.report_laundry_order_receipt">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-call="web.basic_layout">
                <style>
                    @page { size: 80mm auto; margin: 2mm; }
                    .gv-slip {
                        width: 76mm;
                        max-width: 76mm;
                        margin: 0 auto;
                        color: #000;
                        font-family: Arial, Helvetica, sans-serif;
                        font-size: 10px;
                        line-height: 1.16;
                    }
                    .gv-center { text-align: center; }
                    .gv-logo { width: 25mm; height: 25mm; object-fit: contain; }
                    .gv-brand { font-size: 14px; line-height: 1.05; font-weight: 800; margin-top: 3px; }
                    .gv-muted { font-size: 9px; }
                    .gv-row { display: table; width: 100%; table-layout: fixed; }
                    .gv-left, .gv-right { display: table-cell; vertical-align: top; }
                    .gv-right { text-align: right; }
                    .gv-delivery { font-size: 12px; font-weight: 800; white-space: nowrap; margin-top: 3px; }
                    .gv-line { border-top: 1px solid #000; margin: 4px 0; }
                    .gv-info div { margin: 1px 0; }
                    .gv-top-info { margin-top: 6px; }
                    .gv-label { font-weight: 800; }
                    .gv-table { width: 100%; border-collapse: collapse; margin-top: 6px; font-size: 9px; }
                    .gv-table th { border-bottom: 1px solid #000; text-align: left; padding: 2px 1px; }
                    .gv-table thead th { text-align: center !important; font-weight: 800; white-space: normal; line-height: 1.05; word-break: normal; overflow-wrap: anywhere; }
                    .gv-table td { padding: 4px 1px; vertical-align: top; }
                    .gv-num { text-align: right; white-space: nowrap; }
                    .gv-note { padding-left: 6px; font-size: 8px; }
                    .gv-totals { width: 100%; border-collapse: collapse; border-top: 1px solid #000; margin-top: 5px; font-size: 9px; }
                    .gv-totals td { padding: 2px 1px; }
                    .gv-summary { margin-top: 9px; text-align: center; font-size: 9px; font-weight: 700; }
                    .gv-terms { margin-top: 6px; font-size: 7px; line-height: 1.05; text-align: left; }
                    .gv-terms div { text-align: left; }
                    .gv-terms-title { text-align: center; font-weight: 800; text-decoration: underline; }
                    .gv-closing { margin-top: 16px; text-align: center; font-size: 9px; font-weight: 800; }
                </style>
                <div class="page gv-slip">
                    <t t-set="source_labels" t-value="dict(doc._fields['source'].selection)"/>
                    <t t-set="priority_labels" t-value="dict(doc.line_ids._fields['goldverse_priority'].selection) if doc.line_ids else {}"/>
                    <t t-set="currency" t-value="doc.currency_id and doc.currency_id.name or 'Rs.'"/>
                    <div class="gv-center">
                        <img class="gv-logo" src="/goldverse_premium_laundry_branding/static/src/img/goldverse-logo.jpeg"/>
                        <div class="gv-brand">
                            GoldVerse Premium<br/>
                            Laundry (<span t-esc="doc.branch_id.code or 'EME'"/>)
                        </div>
                        <div class="gv-muted">Elite Threads, Elite Care...</div>
                        <div class="gv-muted">
                            <span t-esc="doc.branch_id.address or '15-D Commercial DHA (EME Phase XII), Lahore'"/><br/>
                            Phone <span t-esc="doc.branch_id.phone or '+92 300 1111 897'"/><br/>
                            Website: www.thegoldverse.com
                        </div>
                    </div>

                    <div class="gv-info gv-top-info">
                        <div><span class="gv-label">Manager:</span> <span t-esc="doc.user_id.name or doc.create_uid.name or ''"/></div>
                        <div><span class="gv-label">Order No.:</span> <span t-esc="doc.name or ''"/></div>
                        <div><span class="gv-label">Order Date:</span> <span t-field="doc.order_date" t-options="{'format': 'dd/MM/yyyy hh:mm a'}"/></div>
                        <div><span class="gv-label">Delivery Date:</span> <span t-field="doc.expected_delivery_datetime" t-options="{'format': 'dd/MM/yyyy hh:mm a'}"/></div>
                        <div><span class="gv-label">Type:</span> <span t-esc="source_labels.get(doc.source, doc.source or '')"/></div>
                    </div>

                    <div class="gv-info">
                        <div><span class="gv-label">Customer :</span> <span t-esc="doc.partner_id.name or ''"/></div>
                        <div><span class="gv-label">Phone No.:</span> <span t-esc="doc.mobile or doc.partner_id.mobile or doc.partner_id.phone or ''"/></div>
                        <div>
                            <span class="gv-label">Customer Address:</span>
                            <span t-esc="doc.partner_id.contact_address or ''"/>
                        </div>
                    </div>

                    <table class="gv-table">
                        <thead>
                            <tr>
                                <th style="width:34%;">Items</th>
                                <th class="gv-num" style="width:10%;">Qty</th>
                                <th class="gv-num" style="width:20%;">Gross Amount</th>
                                <th class="gv-num" style="width:14%;">Disc</th>
                                <th class="gv-num" style="width:22%;">Net<br/>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.line_ids" t-as="line">
                                <t t-set="line_qty" t-value="line.quantity or 0.0"/>
                                <t t-set="line_gross" t-value="(line.goldverse_base_price or line.unit_price or 0.0) * line_qty"/>
                                <t t-set="line_discount" t-value="line.goldverse_discount_amount or 0.0"/>
                                <tr>
                                    <td>
                                        <span t-esc="line._goldverse_service_detail()"/>
                                    </td>
                                    <td class="gv-num"><span t-esc="'{:,.0f}'.format(line.quantity or 0.0)"/></td>
                                    <td class="gv-num"><span t-esc="'{:,.0f}'.format(line_gross)"/></td>
                                    <td class="gv-num"><span t-esc="'{:,.0f}'.format(line_discount)"/></td>
                                    <td class="gv-num"><span t-esc="'{:,.0f}'.format(line.price_subtotal or 0.0)"/></td>
                                </tr>
                                <tr t-if="line.goldverse_colour_id or line.color or line.goldverse_qc_option_ids or line.goldverse_topup_ids or line.goldverse_priority != 'normal'">
                                    <td colspan="5" class="gv-note">
                                        <div t-if="line.goldverse_colour_id or line.color">
                                            + <span t-esc="line.goldverse_colour_id.name or line.color"/> - 0
                                        </div>
                                        <div t-foreach="line.goldverse_qc_option_ids" t-as="qc">
                                            + <span t-esc="qc.name"/> - 0
                                        </div>
                                        <div t-foreach="line.goldverse_topup_ids" t-as="addon">
                                            + <span t-esc="addon.name"/> - 0
                                        </div>
                                        <div t-if="line.goldverse_priority != 'normal'">
                                            + <span t-esc="priority_labels.get(line.goldverse_priority, line.goldverse_priority)"/> Service - <span t-esc="'{:,.0f}'.format(line.goldverse_priority_charge or 0.0)"/>
                                        </div>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <t t-set="subtotal_qty" t-value="sum(doc.line_ids.mapped('quantity')) or 0.0"/>
                    <t t-set="subtotal_gross" t-value="sum([((line.goldverse_base_price or line.unit_price or 0.0) * (line.quantity or 0.0)) for line in doc.line_ids]) or 0.0"/>
                    <t t-set="subtotal_discount" t-value="sum(doc.line_ids.mapped('goldverse_discount_amount')) or 0.0"/>
                    <t t-set="subtotal_amount" t-value="sum(doc.line_ids.mapped('price_subtotal')) or 0.0"/>
                    <table class="gv-totals">
                        <tr>
                            <td><strong>SubTotal</strong></td>
                            <td class="gv-num"><span t-esc="'{:,.0f}'.format(subtotal_qty)"/></td>
                            <td class="gv-num"><span t-esc="'{:,.0f}'.format(subtotal_gross)"/></td>
                            <td class="gv-num"><span t-esc="'{:,.0f}'.format(subtotal_discount)"/></td>
                            <td class="gv-num"><span t-esc="'{:,.0f}'.format(subtotal_amount)"/></td>
                        </tr>
                        <tr>
                            <td colspan="4"><strong>Advance Paid</strong></td>
                            <td class="gv-num"><span t-esc="'{:,.0f}'.format(doc.advance_paid or 0.0)"/></td>
                        </tr>
                        <tr>
                            <td colspan="4"><strong>Net Total</strong></td>
                            <td class="gv-num"><span t-esc="'{:,.0f}'.format(doc.amount_total or 0.0)"/></td>
                        </tr>
                        <tr>
                            <td colspan="4"><strong>Wallet Balance Used</strong></td>
                            <td class="gv-num"><span t-esc="'{:,.0f}'.format(doc.wallet_used_amount or 0.0)"/></td>
                        </tr>
                        <tr>
                            <td colspan="4"><strong>Net Balance</strong></td>
                            <td class="gv-num"><span t-esc="'{:,.0f}'.format(doc.net_balance_amount or doc.balance_amount or 0.0)"/></td>
                        </tr>
                    </table>

                    <div class="gv-summary">
                        Total Items: <span t-esc="len(doc.line_ids)"/>
                        Total QTY: <span t-esc="'{:,.0f}'.format(sum(doc.line_ids.mapped('quantity')) or 0.0)"/><br/>
                        Express service +25%, Urgent service +40%
                    </div>

                    <div class="gv-terms">
                        <div class="gv-terms-title">Terms &amp; Conditions</div>
                        <div>1. Please check pockets before handing over garments. GoldVerse is not responsible for cash, jewelry, cards, or personal items left inside.</div>
                        <div>2. Original receipt/order number is required at collection.</div>
                        <div>3. Stains, color bleeding, shrinkage, weak fabric damage, or defects from previous wear/wash are processed at customer risk.</div>
                        <div>4. Stain removal is done on a best-effort basis and is not guaranteed.</div>
                        <div>5. Please inspect garments at delivery. Complaints must be reported before leaving the outlet or within 24 hours.</div>
                        <div>6. Unclaimed garments after 30 days may incur storage charges.</div>
                        <div>7. Unclaimed garments after 90 days may be disposed of without further claim.</div>
                        <div>8. Delivery time is estimated and may vary due to workload, weather, power outage, or other operational reasons.</div>
                        <div>9. Liability, if accepted, is limited to laundry service charges only, not garment replacement value.</div>
                        <div>10. Payment must be cleared before delivery.</div>
                        <div>11. GoldVerse does not operate on Sundays and public holidays.</div>
                        <div>12. Customer confirms and agrees to these terms by accepting this order slip.</div>
                    </div>

                    <div class="gv-closing">Happy to Serve You Best!</div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
