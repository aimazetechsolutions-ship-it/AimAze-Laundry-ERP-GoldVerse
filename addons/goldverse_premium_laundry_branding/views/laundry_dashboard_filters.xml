<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_laundry_order_search_goldverse_dashboard_filters" model="ir.ui.view">
        <field name="name">aimaze.laundry.order.search.goldverse.dashboard.filters</field>
        <field name="model">aimaze.laundry.order</field>
        <field name="inherit_id" ref="aimaze_laundry_management.view_laundry_order_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='today']" position="after">
                <filter string="MTD"
                        name="gv_mtd"
                        domain="[('order_date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d 00:00:00')),
                                 ('order_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="YTD"
                        name="gv_ytd"
                        domain="[('order_date', '&gt;=', (context_today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d 00:00:00')),
                                 ('order_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="ITD" name="gv_itd" domain="[]"/>
                <filter string="Custom" name="gv_custom_range" domain="[]"/>
                <separator/>
                <filter string="All Customers" name="gv_all_customers" domain="[]"/>
                <filter string="B2C" name="gv_b2c" domain="[('customer_type', '=', 'b2c')]"/>
                <filter string="B2B" name="gv_b2b" domain="[('customer_type', '=', 'b2b')]"/>
            </xpath>
        </field>
    </record>

