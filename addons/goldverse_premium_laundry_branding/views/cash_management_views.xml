<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_goldverse_cash_transaction_list" model="ir.ui.view">
        <field name="name">goldverse.cash.transaction.list</field>
        <field name="model">goldverse.cash.transaction</field>
        <field name="arch" type="xml">
            <list string="Cash Desk" decoration-success="state == 'posted'" decoration-muted="state == 'cancelled'">
                <field name="date" optional="show"/>
                <field name="name" optional="show"/>
                <field name="transaction_type" optional="show"/>
                <field name="branch_id" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="expense_head_id" optional="show"/>
                <field name="description" optional="show"/>
                <field name="amount" optional="show" sum="Total"/>
                <field name="state" widget="badge" optional="show"/>
                <field name="account_move_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_goldverse_cash_transaction_form" model="ir.ui.view">
        <field name="name">goldverse.cash.transaction.form</field>
        <field name="model">goldverse.cash.transaction</field>
        <field name="arch" type="xml">
            <form string="Cash Desk">
                <header>
                    <button name="action_post" type="object" string="Post Entry" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'draft'"/>
                    <button name="action_view_journal_entry" type="object" string="View Journal Entry" invisible="not account_move_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Cash Action">
                            <field name="transaction_type" widget="radio" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="expense_head_id" invisible="transaction_type != 'expense'" required="transaction_type == 'expense'" readonly="state != 'draft'" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="description" readonly="state != 'draft'"/>
                        </group>
                        <group string="Branch and User">
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="branch_id" readonly="state != 'draft'" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="user_id" readonly="state != 'draft'" options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>
                    <group string="Live Cash Position">
                        <field name="main_cash_balance" readonly="1"/>
                        <field name="petty_cash_balance" readonly="1"/>
                    </group>
                    <group string="Receipt">
                        <field name="receipt_attachment" filename="receipt_filename" readonly="state != 'draft'"/>
                        <field name="receipt_filename" invisible="1"/>
                    </group>
                    <group string="Accounting">
                        <field name="account_move_id" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_goldverse_cash_transaction_search" model="ir.ui.view">
        <field name="name">goldverse.cash.transaction.search</field>
        <field name="model">goldverse.cash.transaction</field>
        <field name="arch" type="xml">
            <search string="Cash Desk">
                <field name="name"/>
                <field name="description"/>
                <field name="transaction_type"/>
                <field name="branch_id"/>
                <field name="user_id"/>
                <field name="expense_head_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <filter name="transfer" string="Transfers" domain="[('transaction_type', '=', 'transfer')]"/>
                <filter name="expense" string="Expenses" domain="[('transaction_type', '=', 'expense')]"/>
                <separator/>
                <filter name="group_type" string="Group by Type" context="{'group_by': 'transaction_type'}"/>
                <filter name="group_branch" string="Group by Branch" context="{'group_by': 'branch_id'}"/>
                <filter name="group_user" string="Group by User" context="{'group_by': 'user_id'}"/>
                <filter name="group_expense_head" string="Group by Expense Head" context="{'group_by': 'expense_head_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_goldverse_cash_transaction" model="ir.actions.act_window">
        <field name="name">Cash Desk</field>
        <field name="res_model">goldverse.cash.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_goldverse_cash_transaction_search"/>
        <field name="context">{'search_default_draft': 1}</field>
    </record>

    <record id="view_goldverse_cash_expense_head_list" model="ir.ui.view">
        <field name="name">goldverse.cash.expense.head.list</field>
        <field name="model">goldverse.cash.expense.head</field>
        <field name="arch" type="xml">
            <list string="Expense Heads" editable="bottom">
                <field name="sequence" optional="show"/>
                <field name="name" optional="show"/>
                <field name="account_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_goldverse_cash_expense_head_form" model="ir.ui.view">
        <field name="name">goldverse.cash.expense.head.form</field>
        <field name="model">goldverse.cash.expense.head</field>
        <field name="arch" type="xml">
            <form string="Expense Head">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="account_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_goldverse_cash_expense_head" model="ir.actions.act_window">
        <field name="name">Expense Heads</field>
        <field name="res_model">goldverse.cash.expense.head</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_goldverse_cash_report_wizard_form" model="ir.ui.view">
        <field name="name">goldverse.cash.report.wizard.form</field>
        <field name="model">goldverse.cash.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Cash Summary Report" create="0" edit="1" delete="0">
                <header>
                    <button name="action_print_pdf" type="object" string="PDF" class="btn-primary"/>
                    <button name="action_export_xlsx" type="object" string="XLSX" class="btn-secondary"/>
                    <button name="action_filter_today" type="object" string="Today" class="btn-secondary"/>
                    <button name="action_filter_mtd" type="object" string="MTD" class="btn-secondary"/>
                    <button name="action_filter_ytd" type="object" string="YTD" class="btn-secondary"/>
                    <button name="action_apply_custom" type="object" string="Apply Custom Dates" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Cash Summary Report</h1>
                    </div>
                    <group>
                        <group string="Filters">
                            <field name="date_filter"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="branch_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group string="Cash Position">
                            <field name="opening_cash"/>
                            <field name="cash_received"/>
                            <field name="cash_paid"/>
                            <field name="closing_cash"/>
                        </group>
                    </group>
                    <group string="Movement Details">
                        <field name="line_ids" nolabel="1">
                            <list string="Cash Movement Details" create="0" edit="0" delete="0">
                                <field name="date" optional="show"/>
                                <field name="name" optional="show"/>
                                <field name="transaction_id" optional="show"/>
                                <field name="transaction_type" optional="show"/>
                                <field name="branch_id" optional="show"/>
                                <field name="user_id" optional="show"/>
                                <field name="expense_head_id" optional="show"/>
                                <field name="description" optional="show"/>
                                <field name="cash_received" optional="show" sum="Cash Received"/>
                                <field name="cash_paid" optional="show" sum="Cash Paid"/>
                                <field name="balance" optional="show"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_goldverse_cash_report_open" model="ir.actions.server">
        <field name="name">Cash Summary Report</field>
        <field name="model_id" ref="model_goldverse_cash_report_wizard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_report()</field>
    </record>

    <record id="paperformat_goldverse_cash_summary_report" model="report.paperformat">
        <field name="name">GoldVerse Cash Summary Report</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_goldverse_cash_summary_pdf" model="ir.actions.report">
        <field name="name">GoldVerse Cash Summary Report</field>
        <field name="model">goldverse.cash.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">goldverse_premium_laundry_branding.report_goldverse_cash_summary_pdf</field>
        <field name="report_file">goldverse_premium_laundry_branding.report_goldverse_cash_summary_pdf</field>
        <field name="paperformat_id" ref="goldverse_premium_laundry_branding.paperformat_goldverse_cash_summary_report"/>
        <field name="attachment_use" eval="False"/>
    </record>

    <template id="report_goldverse_cash_summary_pdf">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="payload" t-value="o._report_payload()"/>
                <div class="goldverse-cash-report-page">
                    <style>
                        .goldverse-cash-report-page {
                            color: #10243a;
                            font-family: Arial, Helvetica, sans-serif;
                            font-size: 10px;
                            line-height: 1.25;
                        }
                        .gv-cash-header {
                            border: 1px solid #d9e2ec;
                            margin-bottom: 10px;
                        }
                        .gv-cash-title {
                            background: #714b67;
                            color: #ffffff;
                            font-size: 20px;
                            font-weight: 700;
                            padding: 10px 12px;
                            text-align: center;
                        }
                        .gv-cash-meta {
                            display: table;
                            width: 100%;
                            background: #fbfcfe;
                            padding: 8px 10px;
                            box-sizing: border-box;
                        }
                        .gv-cash-meta-left,
                        .gv-cash-meta-right {
                            display: table-cell;
                            width: 50%;
                            vertical-align: top;
                        }
                        .gv-cash-meta-right {
                            text-align: right;
                        }
                        .gv-cash-company {
                            font-size: 13px;
                            font-weight: 700;
                        }
                        .gv-cash-muted {
                            color: #5c6f84;
                        }
                        .gv-summary-grid {
                            display: table;
                            width: 100%;
                            margin: 8px 0 12px 0;
                            border-collapse: separate;
                            border-spacing: 6px 0;
                        }
                        .gv-summary-card {
                            display: table-cell;
                            width: 25%;
                            border: 1px solid #d9e2ec;
                            border-left: 4px solid #22b8cf;
                            padding: 8px;
                            background: #fbfcfe;
                        }
                        .gv-summary-card strong {
                            display: block;
                            color: #5c6f84;
                            font-size: 9px;
                            text-transform: uppercase;
                        }
                        .gv-summary-card span {
                            display: block;
                            color: #10243a;
                            font-size: 13px;
                            font-weight: 700;
                            margin-top: 4px;
                            text-align: right;
                        }
                        table.gv-cash-table {
                            width: 100%;
                            border-collapse: collapse;
                            table-layout: fixed;
                        }
                        .gv-cash-table th {
                            background: #10243a;
                            color: #ffffff;
                            border: 1px solid #10243a;
                            font-size: 9px;
                            font-weight: 700;
                            padding: 5px;
                            text-align: center;
                            vertical-align: middle;
                        }
                        .gv-cash-table td {
                            border: 1px solid #d9e2ec;
                            padding: 4px 5px;
                            vertical-align: top;
                            word-wrap: break-word;
                        }
                        .gv-cash-table tbody tr:nth-child(even) td {
                            background: #fbfcfe;
                        }
                        .gv-cash-table .gv-number {
                            text-align: right;
                            white-space: nowrap;
                        }
                        .gv-cash-table .gv-total td {
                            background: #eaf2f6;
                            font-weight: 700;
                        }
                        .gv-cash-footer {
                            margin-top: 8px;
                            color: #5c6f84;
                            font-size: 8px;
                            text-align: right;
                        }
                    </style>

                    <div class="gv-cash-header">
                        <div class="gv-cash-title">GoldVerse Cash Summary Report</div>
                        <div class="gv-cash-meta">
                            <div class="gv-cash-meta-left">
                                <div class="gv-cash-company"><t t-esc="payload.get('company')"/></div>
                                <div>Branch: <span class="gv-cash-muted"><t t-esc="payload.get('branch')"/></span></div>
                                <div>Period: <span class="gv-cash-muted"><t t-esc="payload.get('period_label')"/></span></div>
                            </div>
                            <div class="gv-cash-meta-right">
                                <div>Filter: <strong><t t-esc="payload.get('date_filter')"/></strong></div>
                                <div>Currency: <strong><t t-esc="payload.get('currency')"/></strong></div>
                            </div>
                        </div>
                    </div>

                    <div class="gv-summary-grid">
                        <div class="gv-summary-card">
                            <strong>Opening Cash</strong>
                            <span><t t-esc="payload.get('opening_cash_text')"/></span>
                        </div>
                        <div class="gv-summary-card">
                            <strong>Cash Received</strong>
                            <span><t t-esc="payload.get('cash_received_text')"/></span>
                        </div>
                        <div class="gv-summary-card">
                            <strong>Cash Paid</strong>
                            <span><t t-esc="payload.get('cash_paid_text')"/></span>
                        </div>
                        <div class="gv-summary-card">
                            <strong>Closing Cash in Hand</strong>
                            <span><t t-esc="payload.get('closing_cash_text')"/></span>
                        </div>
                    </div>

                    <table class="gv-cash-table">
                        <thead>
                            <tr>
                                <th style="width: 8%;">Date</th>
                                <th style="width: 12%;">Reference</th>
                                <th style="width: 11%;">Type</th>
                                <th style="width: 12%;">Branch</th>
                                <th style="width: 12%;">User</th>
                                <th style="width: 23%;">Description</th>
                                <th style="width: 9%;">Cash Received</th>
                                <th style="width: 8%;">Cash Paid</th>
                                <th style="width: 10%;">Closing Cash</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-if="not payload.get('lines')">
                                <td colspan="9" style="text-align: center;">No cash movement found for the selected filters.</td>
                            </tr>
                            <tr t-foreach="payload.get('lines')" t-as="line">
                                <td><t t-esc="line.get('date')"/></td>
                                <td><t t-esc="line.get('reference')"/></td>
                                <td><t t-esc="line.get('type')"/></td>
                                <td><t t-esc="line.get('branch')"/></td>
                                <td><t t-esc="line.get('user')"/></td>
                                <td><t t-esc="line.get('description')"/></td>
                                <td class="gv-number"><t t-esc="line.get('cash_received_text')"/></td>
                                <td class="gv-number"><t t-esc="line.get('cash_paid_text')"/></td>
                                <td class="gv-number"><t t-esc="line.get('balance_text')"/></td>
                            </tr>
                            <tr class="gv-total">
                                <td colspan="6">Report Total</td>
                                <td class="gv-number"><t t-esc="payload.get('cash_received_text')"/></td>
                                <td class="gv-number"><t t-esc="payload.get('cash_paid_text')"/></td>
                                <td class="gv-number"><t t-esc="payload.get('closing_cash_text')"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="gv-cash-footer">Generated by AimAze Laundry ERP</div>
                </div>
            </t>
        </t>
    </template>

    <record id="view_laundry_account_config_form_goldverse_cash" model="ir.ui.view">
        <field name="name">aimaze.laundry.account.config.form.goldverse.cash</field>
        <field name="model">aimaze.laundry.account.config</field>
        <field name="inherit_id" ref="aimaze_laundry_management.view_laundry_account_config_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='compensation_expense_account_id']" position="after">
                <field name="main_cash_account_id"/>
                <field name="petty_cash_account_id"/>
            </xpath>
            <xpath expr="//field[@name='card_journal_id']" position="after">
                <field name="cash_transfer_journal_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_laundry_account_config_list_goldverse_cash" model="ir.ui.view">
        <field name="name">aimaze.laundry.account.config.list.goldverse.cash</field>
        <field name="model">aimaze.laundry.account.config</field>
        <field name="inherit_id" ref="aimaze_laundry_management.view_laundry_account_config_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='cash_journal_id']" position="before">
                <field name="main_cash_account_id" optional="show"/>
                <field name="petty_cash_account_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='cash_journal_id']" position="after">
                <field name="cash_transfer_journal_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_goldverse_cash_root" name="Cash Management" sequence="45" web_icon="aimaze_laundry_management,static/description/icon.png"/>
    <menuitem id="menu_goldverse_cash_desk" name="Cash Desk" parent="menu_goldverse_cash_root" action="action_goldverse_cash_transaction" sequence="10"/>
    <menuitem id="menu_goldverse_cash_report" name="Cash Summary Report" parent="menu_goldverse_cash_root" action="action_goldverse_cash_report_open" sequence="15"/>
    <menuitem id="menu_goldverse_cash_expense_heads" name="Expense Heads" parent="menu_goldverse_cash_root" action="action_goldverse_cash_expense_head" sequence="20" groups="base.group_system,aimaze_laundry_management.group_laundry_admin"/>
</odoo>
