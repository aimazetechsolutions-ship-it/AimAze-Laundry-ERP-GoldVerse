<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_dashboard_tree" model="ir.ui.view">
        <field name="name">account.payment.dashboard.tree</field>
        <field name="model">account.payment</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Payments" decoration-info="state == 'draft'" decoration-muted="state == 'cancel'">
                <field name="date"/>
                <field name="name"/>
                <field name="aimaze_laundry_order_id" string="Order No." optional="show"/>
                <field name="goldverse_laundry_order_date" string="Order Date" widget="datetime" optional="show"/>
                <field name="journal_id"/>
                <field name="payment_method_line_id"/>
                <field name="partner_id" string="Customer"/>
                <field name="amount_signed" string="Amount in Currency" sum="Amount in Currency"/>
                <field name="amount" string="Amount" sum="Amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('paid','in_process')"
                       decoration-info="state == 'posted'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_invoice_tree_goldverse_laundry_order" model="ir.ui.view">
        <field name="name">account.move.tree.goldverse.laundry.order</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="aimaze_laundry_order_id" string="Laundry Order" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_goldverse_laundry_order" model="ir.ui.view">
        <field name="name">account.move.tree.entries.goldverse.laundry.order</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="aimaze_laundry_order_id" string="Laundry Order" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
