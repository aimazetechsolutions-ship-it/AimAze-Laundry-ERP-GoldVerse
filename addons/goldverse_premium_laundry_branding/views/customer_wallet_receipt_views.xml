<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_goldverse_customer_wallet_receipt_list" model="ir.ui.view">
        <field name="name">goldverse.customer.wallet.receipt.list</field>
        <field name="model">goldverse.customer.wallet.receipt</field>
        <field name="arch" type="xml">
            <list string="Customer Wallet Receipts" decoration-success="state == 'posted'" decoration-muted="state == 'cancelled'">
                <field name="receipt_date" optional="show"/>
                <field name="name" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="mobile" optional="show"/>
                <field name="branch_id" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="journal_id" optional="show"/>
                <field name="amount" optional="show" sum="Total"/>
                <field name="ar_credit_balance" optional="show"/>
                <field name="payment_id" optional="show"/>
                <field name="state" widget="badge" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_goldverse_customer_wallet_receipt_form" model="ir.ui.view">
        <field name="name">goldverse.customer.wallet.receipt.form</field>
        <field name="model">goldverse.customer.wallet.receipt</field>
        <field name="arch" type="xml">
            <form string="Customer Wallet Receipt">
                <header>
                    <button name="action_post" type="object" string="Post Receipt" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Reset Voucher" invisible="state != 'draft'" confirm="Are you sure you want to reset/cancel this customer wallet receipt?"/>
                    <button name="action_view_payment" type="object" string="View Payment" invisible="not payment_id"/>
                    <button name="action_view_journal_entry" type="object" string="View Journal Entry" invisible="not payment_move_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="partner_id"
                                   readonly="state != 'draft'"
                                   domain="[('customer_rank', '&gt;', 0)]"
                                   context="{'default_customer_rank': 1, 'default_laundry_customer_type': 'b2c', 'default_goldverse_customer_category': 'b2c', 'default_company_type': 'person', 'default_is_company': False, 'default_phone': mobile, 'default_mobile': mobile}"
                                   options="{'no_quick_create': True}"/>
                            <field name="mobile" invisible="1"/>
                            <field name="mobile_partner_id"
                                   string="Mobile"
                                   readonly="state != 'draft'"
                                   required="1"
                                   domain="[('customer_rank', '>', 0), '|', ('mobile', '!=', False), ('phone', '!=', False)]"
                                   context="{'goldverse_mobile_lookup': True, 'default_customer_rank': 1, 'default_laundry_customer_type': 'b2c', 'default_goldverse_customer_category': 'b2c', 'default_company_type': 'person', 'default_is_company': False}"
                                   options="{'no_quick_create': True}"/>
                            <button name="action_create_customer_from_mobile"
                                    type="object"
                                    string="Create Customer"
                                    class="btn-secondary"
                                    invisible="state != 'draft' or partner_id or not mobile"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="ar_credit_balance" readonly="1"/>
                            <field name="memo" readonly="state != 'draft'"/>
                        </group>
                        <group string="Receipt">
                            <field name="receipt_date" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="branch_id" readonly="state != 'draft'" required="1" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="user_id" readonly="state != 'draft'" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="journal_id" readonly="state != 'draft'" required="1" options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>
                    <group string="Accounting">
                        <field name="payment_id" readonly="1"/>
                        <field name="payment_move_id" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_goldverse_customer_wallet_receipt_search" model="ir.ui.view">
        <field name="name">goldverse.customer.wallet.receipt.search</field>
        <field name="model">goldverse.customer.wallet.receipt</field>
        <field name="arch" type="xml">
            <search string="Customer Wallet Receipts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="mobile"/>
                <field name="branch_id"/>
                <field name="user_id"/>
                <field name="journal_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <separator/>
                <filter name="group_customer" string="Group by Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_branch" string="Group by Branch" context="{'group_by': 'branch_id'}"/>
                <filter name="group_user" string="Group by User" context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_goldverse_customer_wallet_receipt" model="ir.actions.act_window">
        <field name="name">Customer Wallet Receipts</field>
        <field name="res_model">goldverse.customer.wallet.receipt</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_goldverse_customer_wallet_receipt_search"/>
        <field name="context">{'search_default_draft': 1}</field>
    </record>

    <menuitem id="menu_goldverse_customer_wallet_receipts"
              name="Customer Wallet Receipts"
              parent="menu_goldverse_cash_root"
              action="action_goldverse_customer_wallet_receipt"
              sequence="12"/>
</odoo>
