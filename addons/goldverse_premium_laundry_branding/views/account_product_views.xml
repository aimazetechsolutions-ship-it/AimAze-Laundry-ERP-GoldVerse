<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_goldverse_account_sellable_products" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="domain">[('active', '=', True), ('product_variant_ids.default_code', '=like', 'GPL-MPL-%')]</field>
        <field name="context">{'search_default_filter_to_sell': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a product in your catalog
            </p>
        </field>
    </record>

    <record id="account.product_product_menu_sellable" model="ir.ui.menu">
        <field name="action" ref="goldverse_premium_laundry_branding.action_goldverse_account_sellable_products"/>
    </record>
</odoo>
