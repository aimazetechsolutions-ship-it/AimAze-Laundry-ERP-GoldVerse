<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_laundry_executive_dashboard_form_goldverse_clickable_cards" model="ir.ui.view">
        <field name="name">aimaze.laundry.executive.dashboard.form.goldverse.clickable.cards</field>
        <field name="model">aimaze.laundry.executive.dashboard</field>
        <field name="inherit_id" ref="aimaze_laundry_management.view_laundry_executive_dashboard_form_phase5"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('alm-dashboard-grid')]" position="replace">
                <div class="alm-dashboard-grid aimaze-premium-grid goldverse-clickable-dashboard-grid">
                    <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'today_sales'}" class="alm-kpi-card alm-kpi-primary goldverse-kpi-button">
                        <span>Today Sales</span><strong><field name="today_sales"/></strong>
                    </button>
                    <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'month_sales'}" class="alm-kpi-card alm-kpi-success goldverse-kpi-button">
                        <span>Monthly Sales</span><strong><field name="month_sales"/></strong>
                    </button>
                    <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'pending_orders'}" class="alm-kpi-card alm-kpi-warning goldverse-kpi-button">
                        <span>Pending Orders</span><strong><field name="pending_orders"/></strong>
                    </button>
                    <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'ready_orders'}" class="alm-kpi-card alm-kpi-info goldverse-kpi-button">
                        <span>Ready Orders</span><strong><field name="ready_orders"/></strong>
                    </button>
                    <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'delivered_orders'}" class="alm-kpi-card alm-kpi-success goldverse-kpi-button">
                        <span>Delivered</span><strong><field name="delivered_orders"/></strong>
                    </button>
                    <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'delayed_orders'}" class="alm-kpi-card alm-kpi-danger goldverse-kpi-button">
                        <span>Delayed</span><strong><field name="delayed_orders"/></strong>
                    </button>
                    <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'open_complaints'}" class="alm-kpi-card goldverse-kpi-button">
                        <span>Open Complaints</span><strong><field name="open_complaints"/></strong>
                    </button>
                    <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'rewash_ratio'}" class="alm-kpi-card goldverse-kpi-button">
                        <span>Rewash Ratio</span><strong><field name="rewash_ratio"/></strong>
                    </button>
                    <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'wallet_liability'}" class="alm-kpi-card goldverse-kpi-button">
                        <span>Wallet Liability</span><strong><field name="wallet_liability"/></strong>
                    </button>
                    <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'advance_liability'}" class="alm-kpi-card goldverse-kpi-button">
                        <span>Advance Liability</span><strong><field name="advance_liability"/></strong>
                    </button>
                    <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'receivables'}" class="alm-kpi-card goldverse-kpi-button">
                        <span>Receivables</span><strong><field name="outstanding_receivables"/></strong>
                    </button>
                    <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'branch_profit'}" class="alm-kpi-card goldverse-kpi-button">
                        <span>Branch Profit</span><strong><field name="branch_profitability"/></strong>
                    </button>
                    <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'staff_score'}" class="alm-kpi-card goldverse-kpi-button">
                        <span>Staff Score</span><strong><field name="staff_productivity"/></strong>
                    </button>
                    <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'driver_performance'}" class="alm-kpi-card goldverse-kpi-button">
                        <span>Driver Performance</span><strong><field name="driver_performance"/></strong>
                    </button>
                    <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'machine_utilization'}" class="alm-kpi-card goldverse-kpi-button">
                        <span>Machine Utilization</span><strong><field name="machine_utilization"/></strong>
                    </button>
                    <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'low_stock'}" class="alm-kpi-card alm-kpi-danger goldverse-kpi-button">
                        <span>Low Stock</span><strong><field name="inventory_low_stock"/></strong>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
