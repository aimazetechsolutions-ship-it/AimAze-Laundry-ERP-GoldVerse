<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_goldverse_open_executive_dashboard" model="ir.actions.server">
        <field name="name">Executive Dashboard</field>
        <field name="model_id" ref="aimaze_laundry_management.model_aimaze_laundry_executive_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = env["aimaze.laundry.executive.dashboard"].action_goldverse_open_executive_dashboard()</field>
    </record>

    <record id="aimaze_laundry_management.menu_laundry_executive_dashboard" model="ir.ui.menu">
        <field name="action" ref="action_goldverse_open_executive_dashboard"/>
        <field name="sequence">1</field>
        <field name="group_ids" eval="[(6, 0, [
            ref('aimaze_laundry_management.group_laundry_admin'),
            ref('base.group_system')
        ])]"/>
    </record>

    <record id="aimaze_laundry_management.menu_laundry_dashboard" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [
            ref('aimaze_laundry_management.group_laundry_admin'),
            ref('base.group_system')
        ])]"/>
    </record>

    <record id="aimaze_laundry_management.menu_laundry_branch_dashboard" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [
            ref('aimaze_laundry_management.group_laundry_admin'),
            ref('base.group_system')
        ])]"/>
    </record>

    <record id="aimaze_laundry_management.menu_aimaze_laundry_root" model="ir.ui.menu">
        <field name="action" ref="action_goldverse_open_executive_dashboard"/>
        <field name="group_ids" eval="[(6, 0, [
            ref('aimaze_laundry_management.group_laundry_admin'),
            ref('base.group_system')
        ])]"/>
    </record>

    <record id="view_laundry_executive_dashboard_form_goldverse_clickable_cards" model="ir.ui.view">
        <field name="name">aimaze.laundry.executive.dashboard.form.goldverse.clickable.cards</field>
        <field name="model">aimaze.laundry.executive.dashboard</field>
        <field name="inherit_id" ref="aimaze_laundry_management.view_laundry_executive_dashboard_form_phase5"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[field[@name='branch_id'] and field[@name='currency_id']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[hasclass('aimaze-dashboard-shell')]" position="replace">
                <div class="goldverse-premium-dashboard goldverse-flat-dashboard">
                    <main class="goldverse-premium-main goldverse-flat-main">
                        <header class="goldverse-flat-header">
                            <div class="goldverse-flat-title">
                                <h2>Executive Dashboard</h2>
                                <div class="goldverse-flat-company"><field name="company_id" readonly="1" nolabel="1"/></div>
                                <div class="goldverse-flat-meta">
                                    <span invisible="not branch_id"><strong>Branch</strong><field name="branch_id" readonly="1" nolabel="1"/></span>
                                    <span><strong>Currency</strong><field name="currency_id" readonly="1" nolabel="1"/></span>
                                </div>
                            </div>
                            <div class="goldverse-flat-filters">
                                <field name="period_filter" widget="selection_badge" nolabel="1" class="aimaze-segmented-field"/>
                                <field name="date_from" invisible="1"/>
                                <field name="date_to" invisible="1"/>
                                <div class="aimaze-custom-range-wrapper" invisible="period_filter != 'custom'">
                                    <a class="aimaze-date-range-pill" role="button">
                                        <i class="fa fa-calendar-o" title="Date range"/>
                                        <field name="date_range_label" nolabel="1" readonly="1" class="aimaze-date-range-label"/>
                                        <i class="fa fa-caret-down aimaze-range-caret" title="Open date range"/>
                                    </a>
                                    <div class="aimaze-date-popover">
                                        <div class="aimaze-date-popover-body">
                                            <span class="o_form_label">From</span>
                                            <input type="date" class="aimaze-range-native-input aimaze-date-from-input"/>
                                            <span class="o_form_label">To</span>
                                            <input type="date" class="aimaze-range-native-input aimaze-date-to-input"/>
                                        </div>
                                        <div class="aimaze-date-popover-footer">
                                            <a class="btn btn-light aimaze-range-cancel" role="button">Cancel</a>
                                            <a class="btn btn-primary aimaze-range-apply" role="button">Apply Range</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </header>

                        <section class="goldverse-flat-section goldverse-sales-section">
                            <div class="goldverse-flat-section-title">
                                <h3>Sales</h3>
                                <strong><field name="date_range_label" readonly="1" nolabel="1"/></strong>
                            </div>
                            <div class="goldverse-flat-card-grid">
                                <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_total_sales'}" class="goldverse-flat-card goldverse-card-total"><span>Total Sales</span><strong><field name="gv_total_sales"/></strong></button>
                                <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_cash_sales'}" class="goldverse-flat-card"><span>Cash Sales</span><strong><field name="gv_cash_sales"/></strong></button>
                                <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_bank_sales'}" class="goldverse-flat-card"><span>Bank Sales</span><strong><field name="gv_bank_sales"/></strong></button>
                                <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_ibft_sales'}" class="goldverse-flat-card"><span>IBFT Sales</span><strong><field name="gv_ibft_sales"/></strong></button>
                                <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_credit_sales'}" class="goldverse-flat-card"><span>Credit Sales</span><strong><field name="gv_credit_sales"/></strong></button>
                            </div>
                        </section>

                        <section class="goldverse-flat-section goldverse-flow-section">
                            <div class="goldverse-flat-section-title">
                                <h3>Order Flow</h3>
                                <strong>Operations</strong>
                            </div>
                            <div class="goldverse-flat-card-grid">
                                <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_total_orders'}" class="goldverse-flat-card goldverse-card-total"><span>Total Orders</span><strong><field name="gv_total_orders"/></strong></button>
                                <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_draft_orders'}" class="goldverse-flat-card"><span>Draft</span><strong><field name="gv_draft_orders"/></strong></button>
                                <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_sent_warehouse_orders'}" class="goldverse-flat-card"><span>Sent to Warehouse</span><strong><field name="gv_sent_warehouse_orders"/></strong></button>
                                <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_received_warehouse_orders'}" class="goldverse-flat-card"><span>Receive from Warehouse</span><strong><field name="gv_received_warehouse_orders"/></strong></button>
                                <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_delivered_customer_orders'}" class="goldverse-flat-card"><span>Delivered to Customers</span><strong><field name="gv_delivered_customer_orders"/></strong></button>
                            </div>
                        </section>

                        <section class="goldverse-flat-section goldverse-finance-flat-section">
                            <div class="goldverse-flat-section-title">
                                <h3>Finance</h3>
                                <strong>Profit and Position</strong>
                            </div>
                            <div class="goldverse-flat-card-grid">
                                <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_gross_profit'}" class="goldverse-flat-card goldverse-card-total"><span>Gross Profit</span><strong><field name="gv_gross_profit"/></strong></button>
                                <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_net_profit'}" class="goldverse-flat-card goldverse-card-finance"><span>Net Profit</span><strong><field name="gv_net_profit"/></strong></button>
                                <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_top_expenses'}" class="goldverse-flat-card goldverse-card-finance"><span>Top 5 Expenses</span><strong><field name="gv_top_expenses"/></strong></button>
                                <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_receivables'}" class="goldverse-flat-card goldverse-card-finance"><span>Receivables</span><strong><field name="gv_receivables"/></strong></button>
                                <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_advances_payables'}" class="goldverse-flat-card goldverse-card-finance"><span>Advances Payables</span><strong><field name="gv_advances_payables"/></strong></button>
                            </div>
                        </section>
                    </main>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
