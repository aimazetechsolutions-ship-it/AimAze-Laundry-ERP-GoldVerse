<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_goldverse_open_executive_dashboard" model="ir.actions.server">
        <field name="name">Executive Dashboard</field>
        <field name="model_id" ref="aimaze_laundry_management.model_aimaze_laundry_executive_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = env["aimaze.laundry.executive.dashboard"].action_goldverse_open_executive_dashboard()</field>
    </record>

    <record id="aimaze_laundry_management.menu_laundry_executive_dashboard" model="ir.ui.menu">
        <field name="action" ref="action_goldverse_open_executive_dashboard"/>
        <field name="sequence">1</field>
    </record>

    <record id="aimaze_laundry_management.menu_aimaze_laundry_root" model="ir.ui.menu">
        <field name="action" ref="action_goldverse_open_executive_dashboard"/>
    </record>

    <record id="view_laundry_executive_dashboard_form_goldverse_clickable_cards" model="ir.ui.view">
        <field name="name">aimaze.laundry.executive.dashboard.form.goldverse.clickable.cards</field>
        <field name="model">aimaze.laundry.executive.dashboard</field>
        <field name="inherit_id" ref="aimaze_laundry_management.view_laundry_executive_dashboard_form_phase5"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[field[@name='branch_id'] and field[@name='currency_id']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[hasclass('aimaze-dashboard-shell')]" position="replace">
                <div class="goldverse-premium-dashboard">
                    <aside class="goldverse-premium-sidebar">
                        <div class="goldverse-sidebar-logo">GV</div>
                        <nav class="goldverse-sidebar-nav">
                            <a class="goldverse-sidebar-item" role="button"><i class="fa fa-th-large"/>Dashboards</a>
                            <a class="goldverse-sidebar-item active" role="button"><i class="fa fa-line-chart"/>Executive Dashboard</a>
                            <a class="goldverse-sidebar-item" role="button"><i class="fa fa-tasks"/>Operational Dashboard</a>
                            <a class="goldverse-sidebar-item" role="button"><i class="fa fa-sitemap"/>Branch Dashboard</a>
                            <a class="goldverse-sidebar-item" role="button"><i class="fa fa-file-text-o"/>Reports</a>
                            <a class="goldverse-sidebar-item" role="button"><i class="fa fa-bar-chart"/>Analytics</a>
                            <a class="goldverse-sidebar-item" role="button"><i class="fa fa-bell-o"/>Alerts</a>
                            <a class="goldverse-sidebar-item" role="button"><i class="fa fa-cog"/>Settings</a>
                        </nav>
                    </aside>

                    <main class="goldverse-premium-main">
                        <header class="goldverse-premium-header">
                            <div class="goldverse-title-block">
                                <span class="goldverse-eyebrow">Executive Analytics</span>
                                <h2>Executive Dashboard</h2>
                                <div class="goldverse-company-line">
                                    <field name="company_id" readonly="1" nolabel="1"/>
                                    <span class="goldverse-branch-pill" invisible="not branch_id"><i class="fa fa-map-marker"/><field name="branch_id" readonly="1" nolabel="1"/></span>
                                </div>
                            </div>
                            <div class="goldverse-header-actions">
                                <div class="goldverse-search-box"><i class="fa fa-search"/><span>Search...</span></div>
                                <div class="goldverse-date-pill"><i class="fa fa-calendar"/><field name="date_range_label" readonly="1" nolabel="1"/></div>
                                <div class="goldverse-currency-pill"><i class="fa fa-money"/><field name="currency_id" readonly="1" nolabel="1"/></div>
                                <a class="goldverse-icon-button" role="button"><i class="fa fa-bell-o"/></a>
                                <a class="goldverse-avatar" role="button">A</a>
                            </div>
                        </header>

                        <section class="goldverse-filter-bar">
                            <div class="goldverse-filter-title">
                                <span>Performance Window</span>
                                <strong><field name="date_range_label" readonly="1"/></strong>
                            </div>
                            <div class="goldverse-period-controls">
                                <field name="period_filter" widget="selection_badge" nolabel="1" class="aimaze-segmented-field"/>
                                <field name="date_from" invisible="1"/>
                                <field name="date_to" invisible="1"/>
                                <div class="aimaze-custom-range-wrapper" invisible="period_filter != 'custom'">
                                    <a class="aimaze-date-range-pill" role="button">
                                        <i class="fa fa-calendar-o" title="Date range"/>
                                        <field name="date_range_label" nolabel="1" readonly="1" class="aimaze-date-range-label"/>
                                        <i class="fa fa-caret-down aimaze-range-caret" title="Open date range"/>
                                    </a>
                                    <div class="aimaze-date-popover">
                                        <div class="aimaze-date-popover-body">
                                            <span class="o_form_label">From</span>
                                            <input type="date" class="aimaze-range-native-input aimaze-date-from-input"/>
                                            <span class="o_form_label">To</span>
                                            <input type="date" class="aimaze-range-native-input aimaze-date-to-input"/>
                                        </div>
                                        <div class="aimaze-date-popover-footer">
                                            <a class="btn btn-light aimaze-range-cancel" role="button">Cancel</a>
                                            <a class="btn btn-primary aimaze-range-apply" role="button">Apply Range</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="goldverse-empty-state" invisible="gv_total_sales or gv_total_orders">
                            <i class="fa fa-info-circle"/>
                            <span>No dashboard values are available for this selected period yet.</span>
                        </section>

                        <section class="goldverse-kpi-grid">
                            <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_total_sales'}" class="goldverse-kpi-card accent-violet">
                                <span class="goldverse-kpi-icon"><i class="fa fa-line-chart"/></span>
                                <span class="goldverse-kpi-label">Total Sales</span>
                                <strong><field name="gv_total_sales"/></strong>
                                <span class="goldverse-kpi-trend positive"><i class="fa fa-arrow-up"/>18.6%</span>
                                <span class="goldverse-sparkline"><span></span></span>
                            </button>
                            <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_cash_sales'}" class="goldverse-kpi-card accent-green">
                                <span class="goldverse-kpi-icon"><i class="fa fa-money"/></span>
                                <span class="goldverse-kpi-label">Cash Sales</span>
                                <strong><field name="gv_cash_sales"/></strong>
                                <span class="goldverse-kpi-trend positive"><field name="gv_cash_sales_share_label"/> share</span>
                                <span class="goldverse-sparkline"><span></span></span>
                            </button>
                            <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_bank_sales'}" class="goldverse-kpi-card accent-blue">
                                <span class="goldverse-kpi-icon"><i class="fa fa-university"/></span>
                                <span class="goldverse-kpi-label">Bank Sales</span>
                                <strong><field name="gv_bank_sales"/></strong>
                                <span class="goldverse-kpi-trend"><field name="gv_bank_sales_share_label"/> share</span>
                                <span class="goldverse-sparkline"><span></span></span>
                            </button>
                            <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_ibft_sales'}" class="goldverse-kpi-card accent-pink">
                                <span class="goldverse-kpi-icon"><i class="fa fa-exchange"/></span>
                                <span class="goldverse-kpi-label">IBFT Sales</span>
                                <strong><field name="gv_ibft_sales"/></strong>
                                <span class="goldverse-kpi-trend"><field name="gv_ibft_sales_share_label"/> share</span>
                                <span class="goldverse-sparkline"><span></span></span>
                            </button>
                            <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_credit_sales'}" class="goldverse-kpi-card accent-orange">
                                <span class="goldverse-kpi-icon"><i class="fa fa-credit-card"/></span>
                                <span class="goldverse-kpi-label">Credit Sales</span>
                                <strong><field name="gv_credit_sales"/></strong>
                                <span class="goldverse-kpi-trend warning"><field name="gv_credit_sales_share_label"/> share</span>
                                <span class="goldverse-sparkline"><span></span></span>
                            </button>
                        </section>

                        <section class="goldverse-chart-grid">
                            <div class="goldverse-chart-card goldverse-sales-overview">
                                <div class="goldverse-card-heading">
                                    <div><span>Sales Overview</span><strong>Total, Cash, Credit, Bank, IBFT</strong></div>
                                    <em><field name="date_range_label"/></em>
                                </div>
                                <div class="goldverse-line-chart">
                                    <div class="goldverse-chart-gridlines"></div>
                                    <svg viewBox="0 0 640 260" preserveAspectRatio="none" aria-label="Sales overview chart">
                                        <polyline points="20,185 135,145 250,160 365,95 500,118 620,52" class="line-total"/>
                                        <polyline points="20,208 135,176 250,190 365,150 500,160 620,118" class="line-cash"/>
                                        <polyline points="20,222 135,185 250,194 365,130 500,148 620,96" class="line-credit"/>
                                        <polyline points="20,232 135,220 250,214 365,206 500,188 620,176" class="line-bank"/>
                                        <polyline points="20,238 135,238 250,238 365,238 500,238 620,238" class="line-ibft"/>
                                    </svg>
                                    <div class="goldverse-chart-legend">
                                        <span><i class="legend-total"></i>Total Sales</span>
                                        <span><i class="legend-cash"></i>Cash Sales</span>
                                        <span><i class="legend-credit"></i>Credit Sales</span>
                                        <span><i class="legend-bank"></i>Bank Sales</span>
                                        <span><i class="legend-ibft"></i>IBFT Sales</span>
                                    </div>
                                </div>
                            </div>

                            <div class="goldverse-chart-card">
                                <div class="goldverse-card-heading">
                                    <div><span>Order Flow</span><strong>Operational movement</strong></div>
                                </div>
                                <div class="goldverse-donut-layout">
                                    <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_total_orders'}" class="goldverse-donut-chart goldverse-order-donut">
                                        <span><field name="gv_total_orders"/></span>
                                        <small>Total Orders</small>
                                    </button>
                                    <div class="goldverse-donut-legend">
                                        <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_draft_orders'}"><i class="dot-gray"></i><span>Draft</span><strong><field name="gv_draft_orders"/></strong></button>
                                        <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_sent_warehouse_orders'}"><i class="dot-blue"></i><span>Sent to Warehouse</span><strong><field name="gv_sent_warehouse_orders"/></strong></button>
                                        <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_received_warehouse_orders'}"><i class="dot-orange"></i><span>Receive from Warehouse</span><strong><field name="gv_received_warehouse_orders"/></strong></button>
                                        <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_delivered_customer_orders'}"><i class="dot-green"></i><span>Delivered to Customers</span><strong><field name="gv_delivered_customer_orders"/></strong></button>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="goldverse-finance-section">
                            <div class="goldverse-section-header">
                                <div><span>Finance Overview</span><strong>Profitability and exposure</strong></div>
                            </div>
                            <div class="goldverse-finance-grid">
                                <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_gross_profit'}" class="goldverse-finance-card"><i class="fa fa-line-chart"/><span>Gross Profit</span><strong><field name="gv_gross_profit"/></strong></button>
                                <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_net_profit'}" class="goldverse-finance-card"><i class="fa fa-pie-chart"/><span>Net Profit</span><strong><field name="gv_net_profit"/></strong></button>
                                <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_top_expenses'}" class="goldverse-finance-card"><i class="fa fa-list-ol"/><span>Top 5 Expenses</span><strong><field name="gv_top_expenses"/></strong></button>
                                <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_receivables'}" class="goldverse-finance-card"><i class="fa fa-user-o"/><span>Receivables</span><strong><field name="gv_receivables"/></strong></button>
                                <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_advances_payables'}" class="goldverse-finance-card"><i class="fa fa-balance-scale"/><span>Advances Payables</span><strong><field name="gv_advances_payables"/></strong></button>
                            </div>
                        </section>

                        <section class="goldverse-chart-grid goldverse-lower-grid">
                            <div class="goldverse-chart-card">
                                <div class="goldverse-card-heading">
                                    <div><span>Sales Breakdown</span><strong>Receipts and credit mix</strong></div>
                                </div>
                                <div class="goldverse-donut-layout">
                                    <div class="goldverse-donut-chart goldverse-sales-donut"><span><field name="gv_total_sales"/></span><small>Total Sales</small></div>
                                    <div class="goldverse-donut-legend">
                                        <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_cash_sales'}"><i class="dot-green"></i><span>Cash Sales</span><strong><field name="gv_cash_sales"/></strong><em><field name="gv_cash_sales_share_label"/></em></button>
                                        <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_credit_sales'}"><i class="dot-orange"></i><span>Credit Sales</span><strong><field name="gv_credit_sales"/></strong><em><field name="gv_credit_sales_share_label"/></em></button>
                                        <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_bank_sales'}"><i class="dot-blue"></i><span>Bank Sales</span><strong><field name="gv_bank_sales"/></strong><em><field name="gv_bank_sales_share_label"/></em></button>
                                        <button type="object" name="action_goldverse_open_dashboard_card" context="{'goldverse_card': 'gv_ibft_sales'}"><i class="dot-pink"></i><span>IBFT Sales</span><strong><field name="gv_ibft_sales"/></strong><em><field name="gv_ibft_sales_share_label"/></em></button>
                                    </div>
                                </div>
                            </div>
                            <div class="goldverse-insight-panel">
                                <div class="goldverse-section-header">
                                    <div><span>Key Insights</span><strong>Executive signals</strong></div>
                                </div>
                                <div class="goldverse-insight-grid">
                                    <div class="goldverse-insight-card"><i class="fa fa-arrow-up"/><span>Total Sales increased by 18.6%</span></div>
                                    <div class="goldverse-insight-card"><i class="fa fa-money"/><span>Cash Sales contributes <field name="gv_cash_sales_share_label"/></span></div>
                                    <div class="goldverse-insight-card"><i class="fa fa-truck"/><span><field name="gv_sent_warehouse_orders"/> orders sent to warehouse</span></div>
                                    <div class="goldverse-insight-card"><i class="fa fa-clock-o"/><span>Receivables outstanding <field name="gv_receivables"/></span></div>
                                    <div class="goldverse-insight-card"><i class="fa fa-percent"/><span>Gross Profit margin 5.79%</span></div>
                                </div>
                            </div>
                        </section>
                    </main>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
