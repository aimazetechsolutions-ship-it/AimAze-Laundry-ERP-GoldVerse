<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_laundry_order_form_goldverse_line_columns" model="ir.ui.view">
        <field name="name">aimaze.laundry.order.form.goldverse.line.columns</field>
        <field name="model">aimaze.laundry.order</field>
        <field name="inherit_id" ref="aimaze_laundry_management.view_laundry_order_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list" position="replace">
                <list editable="bottom">
                    <field name="currency_id" column_invisible="1"/>
                    <field name="goldverse_category_id" string="Category" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="goldverse_subcategory_id" string="Sub Category" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="service_id" string="Service Item" domain="[('category_id', '=', goldverse_category_id), ('goldverse_subcategory_id', '=', goldverse_subcategory_id)]" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="goldverse_priority" string="Priority" required="1"/>
                    <field name="goldverse_colour_ids" string="Colour" widget="many2many_tags" required="1" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="goldverse_qc_option_ids" string="QC" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="goldverse_topup_ids" string="Add On" widget="many2many_tags" required="1" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="unit_price" column_invisible="1" force_save="1"/>
                    <field name="discount" column_invisible="1" force_save="1"/>
                    <field name="tax_ids" column_invisible="1" force_save="1"/>
                    <field name="quantity" string="Qty"/>
                    <field name="goldverse_base_price" string="Base Price" readonly="1"/>
                    <field name="goldverse_discount_amount" string="Discount" readonly="1"/>
                    <field name="goldverse_net_price" string="Net Price" readonly="1"/>
                    <field name="goldverse_priority_charge" string="Priority Chgs" readonly="1"/>
                    <field name="price_subtotal" string="Total Excl. Tax" readonly="1"/>
                    <field name="price_tax" string="Tax" readonly="1"/>
                    <field name="goldverse_total_amount" string="Total Incl. Tax" readonly="1"/>
                </list>
            </xpath>
            <xpath expr="//field[@name='line_ids']/ancestor::page[1]//group[hasclass('alm-total-box')]" position="attributes">
                <attribute name="class">alm-total-box goldverse-total-box</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/ancestor::page[1]//field[@name='total_qty']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='discount_amount']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_tax']" position="after">
                <xpath expr="//field[@name='delivery_charge']" position="move"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/ancestor::page[1]" position="after">
                <page string="Warehouse Receiving">
                    <field name="line_ids" readonly="1">
                        <list>
                            <field name="name" string="Line"/>
                            <field name="service_id" string="Service Item" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="goldverse_colour_ids" string="Colour" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="quantity" string="Qty"/>
                            <field name="warehouse_sent_datetime"/>
                            <field name="warehouse_received_datetime"/>
                            <field name="warehouse_sent" widget="boolean_toggle"/>
                            <field name="warehouse_received" widget="boolean_toggle"/>
                            <button name="action_mark_warehouse_received" type="object" string="Receive Line" class="btn-primary" invisible="not warehouse_sent or warehouse_received" confirm="Are you sure you want to mark this line as received back from warehouse?"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_laundry_order_line_warehouse_sending_list" model="ir.ui.view">
        <field name="name">aimaze.laundry.order.line.warehouse.sending.list</field>
        <field name="model">aimaze.laundry.order.line</field>
        <field name="arch" type="xml">
            <list string="Send Order Lines" create="0" edit="0">
                <field name="order_id"/>
                <field name="name" string="Line"/>
                <field name="service_id" string="Service Item" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="goldverse_colour_ids" string="Colour" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="quantity" string="Qty"/>
                <field name="warehouse_sent_datetime"/>
                <field name="warehouse_sent" widget="boolean_toggle"/>
                <button name="action_mark_warehouse_sent" type="object" string="Send Line" class="btn-primary" invisible="warehouse_sent" confirm="Are you sure you want to send this line to warehouse? This will create/post the invoice if needed."/>
            </list>
        </field>
    </record>

    <record id="view_laundry_order_line_warehouse_receiving_list" model="ir.ui.view">
        <field name="name">aimaze.laundry.order.line.warehouse.receiving.list</field>
        <field name="model">aimaze.laundry.order.line</field>
        <field name="arch" type="xml">
            <list string="Receive Order Lines" create="0" edit="0">
                <field name="order_id"/>
                <field name="name" string="Line"/>
                <field name="service_id" string="Service Item" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="goldverse_colour_ids" string="Colour" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="quantity" string="Qty"/>
                <field name="warehouse_sent_datetime"/>
                <field name="warehouse_received_datetime"/>
                <field name="warehouse_sent" widget="boolean_toggle"/>
                <field name="warehouse_received" widget="boolean_toggle"/>
                <button name="action_mark_warehouse_received" type="object" string="Receive Line" class="btn-primary" invisible="not warehouse_sent or warehouse_received" confirm="Are you sure you want to mark this line as received back from warehouse?"/>
            </list>
        </field>
    </record>

    <record id="view_laundry_order_line_warehouse_movement_list" model="ir.ui.view">
        <field name="name">aimaze.laundry.order.line.warehouse.movement.list</field>
        <field name="model">aimaze.laundry.order.line</field>
        <field name="arch" type="xml">
            <list string="Warehouse Movement Report" create="0">
                <field name="order_id"/>
                <field name="name" string="Line"/>
                <field name="service_id" string="Service Item" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="goldverse_colour_ids" string="Colour" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="quantity" string="Qty"/>
                <field name="branch_id"/>
                <field name="warehouse_sent_datetime"/>
                <field name="warehouse_received_datetime"/>
                <field name="warehouse_sent" widget="boolean_toggle"/>
                <field name="warehouse_received" widget="boolean_toggle"/>
                <button name="action_mark_warehouse_received" type="object" string="Receive Line" class="btn-primary" invisible="not warehouse_sent or warehouse_received" confirm="Are you sure you want to mark this line as received back from warehouse?"/>
            </list>
        </field>
    </record>
</odoo>
