<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <function model="goldverse.laundry.qc.option" name="write">
        <function model="goldverse.laundry.qc.option" name="search">
            <value eval="[('name', 'in', ['Pending', 'Pass', 'Fail', 'Rewash', 'Stain', 'Damage', 'Colour Faint', 'Color Faint'])]"/>
        </function>
        <value eval="{'active': False}"/>
    </function>
    <function model="goldverse.laundry.topup" name="write">
        <function model="goldverse.laundry.topup" name="search">
            <value eval="[('name', 'in', ['Starch', 'Hangers'])]"/>
        </function>
        <value eval="{'active': False}"/>
    </function>

