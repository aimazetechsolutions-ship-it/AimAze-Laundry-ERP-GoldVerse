<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_laundry_payment_wizard_form" model="ir.ui.view">
        <field name="name">aimaze.laundry.payment.wizard.form</field>
        <field name="model">aimaze.laundry.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Laundry Payment">
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="partner_id" readonly="1"/>
                    <field name="amount_due" readonly="1"/>
                    <field name="amount"/>
                    <field name="is_advance"/>
                    <field name="payment_method_id"/>
                    <field name="journal_id"/>
                    <field name="payment_date"/>
                    <field name="memo"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_register_payment" type="object" string="Register Payment" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
