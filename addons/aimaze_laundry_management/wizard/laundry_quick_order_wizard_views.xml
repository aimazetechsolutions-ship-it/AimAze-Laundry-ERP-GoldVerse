<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_laundry_quick_order_wizard_form" model="ir.ui.view">
        <field name="name">aimaze.laundry.quick.order.wizard.form</field>
        <field name="model">aimaze.laundry.quick.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Quick Counter Order">
                <header>
                    <button name="action_find_customer" type="object" string="Find Customer" class="alm-btn-info"/>
                    <button name="action_create_customer" type="object" string="Create Customer" class="alm-btn-success"/>
                    <button name="action_create_order" type="object" string="Confirm Counter Order" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group string="Customer">
                            <field name="mobile" placeholder="Search by mobile"/>
                            <field name="partner_id"/>
                            <field name="customer_name"/>
                            <field name="email"/>
                            <field name="wallet_balance" readonly="1"/>
                            <field name="loyalty_points" readonly="1"/>
                            <field name="previous_balance" readonly="1"/>
                        </group>
                        <group string="Order">
                            <field name="branch_id"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="priority"/>
                            <field name="pickup_required"/>
                            <field name="delivery_required"/>
                            <field name="delivery_charge"/>
                        </group>
                    </group>
                    <group string="Quick Add Service">
                        <group>
                            <field name="service_category_id"/>
                            <field name="service_id" domain="[('category_id','=',service_category_id)]"/>
                            <field name="garment_category"/>
                            <field name="garment_item"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <button name="action_qty_minus" type="object" string="- Qty" class="btn-secondary"/>
                            <button name="action_qty_plus" type="object" string="+ Qty" class="btn-secondary"/>
                            <button name="action_add_service" type="object" string="Add Service" class="alm-btn-success"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="service_id"/>
                            <field name="garment_category"/>
                            <field name="garment_item"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="subtotal"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group class="alm-total-box">
                        <group>
                            <field name="discount_amount"/>
                            <field name="advance_amount"/>
                            <field name="journal_id"/>
                        </group>
                        <group>
                            <field name="amount_total" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_laundry_quick_counter_order" model="ir.actions.act_window">
        <field name="name">Quick Counter Order</field>
        <field name="res_model">aimaze.laundry.quick.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
