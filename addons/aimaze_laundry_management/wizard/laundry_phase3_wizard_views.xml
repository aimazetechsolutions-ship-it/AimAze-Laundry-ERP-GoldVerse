<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_laundry_scan_wizard_form" model="ir.ui.view">
        <field name="name">aimaze.laundry.scan.wizard.form</field>
        <field name="model">aimaze.laundry.scan.wizard</field>
        <field name="arch" type="xml">
            <form string="Barcode / RFID Scan">
                <header>
                    <button name="action_scan" type="object" string="Scan" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="barcode" placeholder="Scan barcode, RFID UID, garment UID, order, or package"/>
                            <field name="scan_target"/>
                            <field name="scan_action"/>
                            <field name="remarks"/>
                        </group>
                        <group>
                            <field name="garment_id" readonly="1"/>
                            <field name="order_id" readonly="1"/>
                            <field name="delivery_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_laundry_barcode_scan_wizard" model="ir.actions.act_window">
        <field name="name">Barcode Scan</field>
        <field name="res_model">aimaze.laundry.scan.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_laundry_setup_wizard_form" model="ir.ui.view">
        <field name="name">aimaze.laundry.setup.wizard.form</field>
        <field name="model">aimaze.laundry.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="AimAze Laundry ERP Initial Setup">
                <header>
                    <button name="action_apply_setup" type="object" string="Apply Setup" class="btn-primary"/>
                </header>
                <sheet>
                    <group string="Company">
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="country_id"/>
                        <field name="currency_id"/>
                    </group>
                    <group string="Default Branch">
                        <field name="branch_name"/>
                        <field name="branch_code"/>
                        <field name="branch_phone"/>
                    </group>
                    <group string="Journals and Tax">
                        <field name="sale_journal_id"/>
                        <field name="cash_journal_id"/>
                        <field name="bank_journal_id"/>
                        <field name="default_tax_id"/>
                    </group>
                    <group string="Accounting Accounts">
                        <field name="advance_liability_account_id"/>
                        <field name="wallet_liability_account_id"/>
                        <field name="laundry_income_account_id"/>
                        <field name="delivery_income_account_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_laundry_setup_wizard" model="ir.actions.act_window">
        <field name="name">Initial Setup Wizard</field>
        <field name="res_model">aimaze.laundry.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
