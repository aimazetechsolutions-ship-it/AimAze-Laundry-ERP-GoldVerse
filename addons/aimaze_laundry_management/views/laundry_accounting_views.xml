<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_laundry_advance_payments" model="ir.actions.act_window">
        <field name="name">Advance Payments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('aimaze_laundry_order_id','!=',False), ('laundry_is_advance','=',True)]</field>
    </record>
    <record id="action_laundry_payments" model="ir.actions.act_window">
        <field name="name">Laundry Payments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('aimaze_laundry_order_id','!=',False)]</field>
    </record>
    <record id="action_laundry_customer_invoices" model="ir.actions.act_window">
        <field name="name">Customer Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type','=','out_invoice'), '|', ('laundry_order_id','!=',False), ('laundry_contract_id','!=',False)]</field>
    </record>
    <record id="action_laundry_refunds" model="ir.actions.act_window">
        <field name="name">Refunds / Credit Notes</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type','=','out_refund'), '|', ('laundry_order_id','!=',False), ('laundry_contract_id','!=',False)]</field>
    </record>
    <record id="action_laundry_cash_closing" model="ir.actions.act_window">
        <field name="name">Daily Cash Closing</field>
        <field name="res_model">aimaze.laundry.cash.closing</field>
        <field name="view_mode">list,form,pivot</field>
    </record>
    <record id="action_laundry_outstanding_receivables" model="ir.actions.act_window">
        <field name="name">Outstanding Receivables</field>
        <field name="res_model">aimaze.laundry.order</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="domain">[('payment_status','!=','paid')]</field>
    </record>
</odoo>
