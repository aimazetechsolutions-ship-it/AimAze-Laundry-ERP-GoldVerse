<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_laundry_order_form_phase2" model="ir.ui.view">
        <field name="name">aimaze.laundry.order.form.phase2</field>
        <field name="model">aimaze.laundry.order</field>
        <field name="inherit_id" ref="view_laundry_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_start_washing']" position="before">
                <button name="action_mark_sorting" type="object" string="Start Sorting" class="alm-btn-stage"/>
            </xpath>
            <xpath expr="//header/button[@name='action_start_ironing']" position="before">
                <button name="action_start_drying" type="object" string="Start Drying" class="alm-btn-stage"/>
            </xpath>
            <xpath expr="//header/button[@name='action_mark_ready']" position="before">
                <button name="action_mark_packing" type="object" string="Start Packing" class="alm-btn-stage"/>
            </xpath>
            <xpath expr="//header/button[@name='action_register_final_payment']" position="after">
                <button name="action_use_wallet" type="object" string="Use Wallet" class="alm-btn-payment"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_open_garments" class="oe_stat_button" icon="fa-tags">
                    <field name="garment_count" widget="statinfo" string="Garments"/>
                </button>
                <button type="object" name="action_open_notification_queue" class="oe_stat_button" icon="fa-envelope">
                    <field name="notification_queue_count" widget="statinfo" string="Messages"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='line_ids']/ancestor::page[1]//group[hasclass('alm-total-box')]/group[2]" position="inside">
                <field name="wallet_used_amount" readonly="1"/>
                <field name="net_balance_amount" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='delivery_ids']/ancestor::page[1]" position="before">
                <page string="Garment Lifecycle">
                    <field name="garment_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="barcode"/>
                            <field name="garment_type"/>
                            <field name="color"/>
                            <field name="brand"/>
                            <field name="current_stage" widget="badge"/>
                            <field name="qc_result" widget="badge"/>
                            <field name="lost_item"/>
                            <field name="rewash_count"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//field[@name='payment_ids']" position="after">
                <field name="wallet_transaction_ids" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_laundry_garment_list" model="ir.ui.view">
        <field name="name">aimaze.laundry.garment.list</field>
        <field name="model">aimaze.laundry.garment</field>
        <field name="arch" type="xml">
            <list string="Garment Tracking" multi_edit="1">
                <field name="name" optional="show"/>
                <field name="barcode" optional="show"/>
                <field name="order_id" optional="show"/>
                <field name="customer_id" optional="show"/>
                <field name="branch_id" optional="show"/>
                <field name="garment_type" optional="show"/>
                <field name="color" optional="show"/>
                <field name="brand" optional="show"/>
                <field name="current_stage" widget="badge" optional="show" decoration-info="current_stage in ('received','sorted','washing','drying','ironing')" decoration-warning="current_stage in ('qc','rewash')" decoration-success="current_stage in ('packing','ready','delivered')" decoration-danger="lost_item"/>
                <field name="current_staff_id" optional="show"/>
                <field name="qc_result" widget="badge" optional="show"/>
                <field name="rewash_count" optional="show"/>
                <field name="delivered" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_laundry_garment_form" model="ir.ui.view">
        <field name="name">aimaze.laundry.garment.form</field>
        <field name="model">aimaze.laundry.garment</field>
        <field name="arch" type="xml">
            <form string="Garment">
                <header>
                    <button name="action_mark_sorted" type="object" string="Sorted" class="alm-btn-stage"/>
                    <button name="action_mark_washing" type="object" string="Washing" class="alm-btn-stage"/>
                    <button name="action_mark_drying" type="object" string="Drying" class="alm-btn-stage"/>
                    <button name="action_mark_ironing" type="object" string="Ironing" class="alm-btn-stage"/>
                    <button name="action_send_qc" type="object" string="QC" class="alm-btn-warning"/>
                    <button name="action_mark_rewash" type="object" string="Rewash" class="alm-btn-danger"/>
                    <button name="action_mark_packed" type="object" string="Packed" class="alm-btn-stage"/>
                    <button name="action_mark_ready" type="object" string="Ready" class="alm-btn-success"/>
                    <button name="action_mark_delivered" type="object" string="Delivered" class="alm-btn-success"/>
                    <field name="current_stage" widget="statusbar" statusbar_visible="received,sorted,washing,drying,ironing,qc,rewash,packing,ready,delivered"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="barcode" readonly="1"/>
                            <field name="order_id"/>
                            <field name="order_line_id"/>
                            <field name="customer_id"/>
                            <field name="branch_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="garment_type"/>
                            <field name="color"/>
                            <field name="brand"/>
                            <field name="fabric_type"/>
                            <field name="current_staff_id"/>
                            <field name="current_location"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Condition">
                            <group>
                                <field name="condition_received"/>
                                <field name="stain_details"/>
                                <field name="damage_details"/>
                                <field name="special_instructions"/>
                            </group>
                        </page>
                        <page string="Photos">
                            <group>
                                <field name="photo_before" widget="image"/>
                                <field name="photo_after" widget="image"/>
                            </group>
                        </page>
                        <page string="QC &amp; Delivery">
                            <group>
                                <field name="qc_result"/>
                                <field name="lost_item"/>
                                <field name="rewash_count" readonly="1"/>
                                <field name="delivered" readonly="1"/>
                                <field name="delivery_datetime" readonly="1"/>
                            </group>
                        </page>
                        <page string="History">
                            <field name="history_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_laundry_garment_search" model="ir.ui.view">
        <field name="name">aimaze.laundry.garment.search</field>
        <field name="model">aimaze.laundry.garment</field>
        <field name="arch" type="xml">
            <search string="Garments">
                <field name="name"/>
                <field name="barcode"/>
                <field name="order_id"/>
                <field name="customer_id"/>
                <field name="garment_type"/>
                <filter string="Lost" name="lost" domain="[('lost_item','=',True)]"/>
                <filter string="Rewash" name="rewash" domain="[('current_stage','=','rewash')]"/>
                <filter string="Ready" name="ready" domain="[('current_stage','=','ready')]"/>
                <group>
                    <filter string="Stage" name="group_stage" context="{'group_by':'current_stage'}"/>
                    <filter string="Branch" name="group_branch" context="{'group_by':'branch_id'}"/>
                    <filter string="Customer" name="group_customer" context="{'group_by':'customer_id'}"/>
                </group>
            </search>
        </field>
    </record>

