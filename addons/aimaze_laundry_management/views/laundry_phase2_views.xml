                    <group string="Taxes">
                        <field name="default_tax_id"/>
                        <field name="uae_vat_tax_id"/>
                        <field name="pakistan_tax_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_laundry_account_config_list" model="ir.ui.view">
        <field name="name">aimaze.laundry.account.config.list</field>
        <field name="model">aimaze.laundry.account.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="advance_liability_account_id"/>
                <field name="wallet_liability_account_id"/>
                <field name="cash_journal_id"/>
                <field name="bank_journal_id"/>
            </list>
        </field>
    </record>
    <record id="action_laundry_account_config" model="ir.actions.act_window">
        <field name="name">Accounting Configuration</field>
        <field name="res_model">aimaze.laundry.account.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_branch_profitability_list" model="ir.ui.view">
        <field name="name">aimaze.laundry.branch.profitability.list</field>
        <field name="model">aimaze.laundry.branch.profitability</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="branch_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="revenue"/>
                <field name="discounts"/>
                <field name="consumable_cost"/>
                <field name="delivery_cost"/>
                <field name="maintenance_cost"/>
                <field name="compensation_cost"/>
                <field name="net_profit"/>
                <field name="profit_margin"/>
            </list>
        </field>
    </record>
    <record id="view_branch_profitability_form" model="ir.ui.view">
        <field name="name">aimaze.laundry.branch.profitability.form</field>
        <field name="model">aimaze.laundry.branch.profitability</field>
        <field name="arch" type="xml">
            <form string="Branch Profitability">
                <header>
                    <button name="action_compute_profitability" type="object" string="Compute" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="branch_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="revenue"/>
                            <field name="discounts"/>
                            <field name="tax"/>
                            <field name="staff_cost"/>
                        </group>
                    </group>
                    <group string="Costs">
                        <field name="consumable_cost"/>
                        <field name="delivery_cost"/>
                        <field name="maintenance_cost"/>
                        <field name="compensation_cost"/>
                    </group>
                    <group string="Profit">
                        <field name="gross_profit" readonly="1"/>
                        <field name="net_profit" readonly="1"/>
                        <field name="profit_margin" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_branch_profitability" model="ir.actions.act_window">
        <field name="name">Branch Profitability</field>
        <field name="res_model">aimaze.laundry.branch.profitability</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

    <record id="view_laundry_executive_dashboard_form" model="ir.ui.view">
        <field name="name">aimaze.laundry.executive.dashboard.form</field>
        <field name="model">aimaze.laundry.executive.dashboard</field>
        <field name="arch" type="xml">
            <form string="Executive Dashboard">
                <sheet>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="branch_id"/>
                        <field name="currency_id"/>
                    </group>
                    <button name="action_open_orders" type="object" string="Open Laundry Analysis" class="btn-primary"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_laundry_executive_dashboard" model="ir.actions.act_window">
        <field name="name">Executive Dashboard</field>
        <field name="res_model">aimaze.laundry.executive.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <record id="action_laundry_driver_mobile" model="ir.actions.act_window">
        <field name="name">Driver Mobile View</field>
        <field name="res_model">aimaze.laundry.delivery</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('driver_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_my_jobs': 1}</field>
    </record>
</odoo>
