<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_aimaze_laundry" model="ir.module.category">
        <field name="name">AimAze Laundry ERP</field>
        <field name="sequence">30</field>
    </record>
    <record id="privilege_aimaze_laundry" model="res.groups.privilege">
        <field name="name">AimAze Laundry ERP</field>
        <field name="category_id" ref="module_category_aimaze_laundry"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_laundry_admin" model="res.groups">
        <field name="name">Laundry Admin</field>
        <field name="privilege_id" ref="privilege_aimaze_laundry"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_branch_manager" model="res.groups">
        <field name="name">Branch Manager</field>
        <field name="privilege_id" ref="privilege_aimaze_laundry"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_cashier" model="res.groups">
        <field name="name">Cashier</field>
        <field name="privilege_id" ref="privilege_aimaze_laundry"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_operator" model="res.groups">
        <field name="name">Laundry Operator</field>
        <field name="privilege_id" ref="privilege_aimaze_laundry"/>
        <field name="sequence">40</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_qc_staff" model="res.groups">
        <field name="name">QC Staff</field>
        <field name="privilege_id" ref="privilege_aimaze_laundry"/>
        <field name="sequence">50</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_driver" model="res.groups">
        <field name="name">Driver</field>
        <field name="privilege_id" ref="privilege_aimaze_laundry"/>
        <field name="sequence">60</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="privilege_id" ref="privilege_aimaze_laundry"/>
        <field name="sequence">70</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_corporate_manager" model="res.groups">
        <field name="name">Corporate Manager</field>
        <field name="privilege_id" ref="privilege_aimaze_laundry"/>
        <field name="sequence">80</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_laundry_order_branch" model="ir.rule">
        <field name="name">Laundry orders by allowed branch</field>
        <field name="model_id" ref="model_aimaze_laundry_order"/>
        <field name="domain_force">['|', ('branch_id', 'in', user.laundry_branch_ids.ids), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_branch_manager')), (4, ref('group_cashier')), (4, ref('group_operator')), (4, ref('group_qc_staff')), (4, ref('group_driver'))]"/>
    </record>
    <record id="rule_laundry_delivery_driver" model="ir.rule">
        <field name="name">Drivers see assigned deliveries</field>
        <field name="model_id" ref="model_aimaze_laundry_delivery"/>
        <field name="domain_force">['|', ('branch_id', 'in', user.laundry_branch_ids.ids), ('driver_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_driver'))]"/>
    </record>
    <record id="rule_laundry_garment_branch" model="ir.rule">
        <field name="name">Laundry garments by allowed branch</field>
        <field name="model_id" ref="model_aimaze_laundry_garment"/>
        <field name="domain_force">['|', ('branch_id', 'in', user.laundry_branch_ids.ids), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_branch_manager')), (4, ref('group_cashier')), (4, ref('group_operator')), (4, ref('group_qc_staff')), (4, ref('group_driver'))]"/>
    </record>
    <record id="rule_laundry_garment_history_branch" model="ir.rule">
        <field name="name">Laundry garment history by allowed branch</field>
        <field name="model_id" ref="model_aimaze_laundry_garment_history"/>
        <field name="domain_force">['|', ('branch_id', 'in', user.laundry_branch_ids.ids), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_branch_manager')), (4, ref('group_operator')), (4, ref('group_qc_staff')), (4, ref('group_driver'))]"/>
    </record>
    <record id="rule_laundry_driver_mobile_only" model="ir.rule">
        <field name="name">Driver mobile assigned jobs only</field>
        <field name="model_id" ref="model_aimaze_laundry_delivery"/>
        <field name="domain_force">[('driver_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_driver'))]"/>
    </record>
    <record id="rule_laundry_ai_analysis_branch" model="ir.rule">
        <field name="name">AI analysis by branch</field>
        <field name="model_id" ref="model_aimaze_laundry_ai_analysis"/>
        <field name="domain_force">['|', ('branch_id', '=', False), ('branch_id', 'in', user.laundry_branch_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_branch_manager')), (4, ref('group_operator')), (4, ref('group_qc_staff'))]"/>
    </record>
    <record id="rule_laundry_integration_log_branch" model="ir.rule">
        <field name="name">Integration logs by branch</field>
        <field name="model_id" ref="model_aimaze_laundry_integration_log"/>
        <field name="domain_force">['|', ('branch_id', '=', False), ('branch_id', 'in', user.laundry_branch_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_branch_manager'))]"/>
    </record>
</odoo>
